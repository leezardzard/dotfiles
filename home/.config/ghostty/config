# Ghostty terminal config.
#
# Loaded by cmux (cmux uses Ghostty under the hood) and any standalone Ghostty
# instance. `cmux reload-config` reloads both this file and ~/.config/cmux/cmux.json
# in-place — no app restart needed.
#
# Two sections below:
#   1. Window appearance — canvas colors + transparency + background blur.
#   2. Orca-parity ANSI 0-15 palette override.
#
# Codes 16-255 in the 256-color cube are NOT remapped here.

###############################################################################
# Window appearance
###############################################################################

# Canvas colors are pinned rather than inherited, so an upstream Ghostty
# release cannot move the background out from under the palette below — or
# from under the cmux sidebar tint keyed to it.
#
# The background is Orca's *app chrome* neutral (its `--sidebar` / `--card`
# token), not the #282c34 of Orca's default terminal theme. Orca paints its
# nav and file tree in this neutral and only the terminal pane in #282c34, so
# matching the terminal theme left a blue-tinted rectangle floating inside
# neutral chrome. Matching the chrome is what actually reads as one surface.
background = #171717
foreground = #ffffff
cursor-color = #ffffff
cursor-text = #171717
selection-background = #5a7898
selection-foreground = #ffffff

# 0.0 (fully transparent) — 1.0 (fully opaque). Orca's default is opaque; 0.95
# keeps a hint of glass without letting the desktop wash out `background` and
# break the contrast step between the pane and the cmux sidebar.
background-opacity = 0.95

# 0 = no blur, higher = stronger frosted-glass effect on the area behind the
# window. Only takes effect when background-opacity < 1.0 and the OS supports
# it (macOS does). Raised alongside the higher opacity so the remaining
# transparency still reads as frosted rather than as a dirty window.
background-blur-radius = 30

###############################################################################
# Orca-parity ANSI 0-15 palette
#
# The Tomorrow Night-derived set from Orca's default terminal theme, carried
# over unchanged against the darker background above. Every CLI tool emitting
# ANSI 0-15 picks these up: p10k cards, `git status`, `eza --color`, `bat`,
# `htop`, completion menus.
#
# Slot 0 (#1d1f21) is now slightly *lighter* than the canvas rather than
# darker. Kept as-is so a "black" cell stays identical to Orca's own — the
# cost is that black-on-black fills read as a faint raised block.
# Format: `palette = N=#hex` for slot N (0-15).
###############################################################################

# Normal (ANSI 0-7)
palette = 0=#1d1f21
palette = 1=#cc6666
palette = 2=#b5bd68
palette = 3=#f0c674
palette = 4=#81a2be
palette = 5=#b294bb
palette = 6=#8abeb7
palette = 7=#c5c8c6

# Bright (ANSI 8-15)
palette = 8=#666666
palette = 9=#d54e53
palette = 10=#b9ca4a
palette = 11=#e7c547
palette = 12=#7aa6da
palette = 13=#c397d8
palette = 14=#70c0b1
palette = 15=#eaeaea

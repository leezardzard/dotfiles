  // Orca-parity overrides for the 16 workspace colors used by `cm cd` on the
  // leftRail card, plus focus (selectionColor) and notification badge. Drawn
  // from the same Tomorrow Night set as the Ghostty ANSI palette so a rail dot
  // and the ANSI color of the same name are the same hue. `selectionColor`
  // mirrors Ghostty's `selection-background`, so pane focus and text selection
  // read as one accent.
  "workspaceColors": {
    "indicatorStyle": "leftRail",
    "selectionColor": "#5a7898",
    "notificationBadgeColor": "#cc6666",
    "colors": {
      "Red":      "#cc6666",
      "Crimson":  "#d54e53",
      "Orange":   "#de935f",
      "Amber":    "#f0c674",
      "Olive":    "#b9ca4a",
      "Green":    "#b5bd68",
      "Teal":     "#8abeb7",
      "Aqua":     "#70c0b1",
      "Blue":     "#81a2be",
      "Navy":     "#4f6b8a",
      "Indigo":   "#7aa6da",
      "Purple":   "#b294bb",
      "Magenta":  "#c397d8",
      "Rose":     "#d7a0a8",
      "Brown":    "#a3785f",
      "Charcoal": "#666666"
    }
  },

  // Sidebar chrome — Orca's own default: a near-neutral tint at low opacity, so
  // the chrome sits quietly against the #282c34 terminal canvas instead of
  // competing with it. `tintColor` is mixed with the system material at
  // `tintOpacity`. Higher opacity = more visible tint (cmux caps it at 0.35).
  "sidebarAppearance": {
    "tintColor": "#18181b",
    "tintOpacity": 0.08,
    "matchTerminalBackground": false,
    "darkModeTintColor": null,
    "lightModeTintColor": null
  },

  "actions": {
    "layout-2-panes": {
      "type": "workspaceCommand",
      "title": "2 panes",
      "subtitle": "New workspace: side-by-side",
      "keywords": ["layout", "split", "panes"],
      "commandName": "2 panes"
    },
    "layout-3-panes": {
      "type": "workspaceCommand",
      "title": "3 panes",
      "subtitle": "New workspace: 2 stacked left + 1 full-height right",
      "keywords": ["layout", "split", "panes"],
      "commandName": "3 panes"
    },
    "layout-4-panes": {
      "type": "workspaceCommand",
      "title": "4 panes",
      "subtitle": "New workspace: 2x2 grid",
      "keywords": ["layout", "split", "panes"],
      "commandName": "4 panes"
    },
    "layout-5-panes": {
      "type": "workspaceCommand",
      "title": "5 panes",
      "subtitle": "New workspace: 2x2 grid + full-height side runner",
      "keywords": ["layout", "split", "panes"],
      "commandName": "5 panes"
    },
    "layout-6-panes": {
      "type": "workspaceCommand",
      "title": "6 panes",
      "subtitle": "New workspace: 3x2 grid",
      "keywords": ["layout", "split", "panes"],
      "commandName": "6 panes"
    },
    "cd-all-dotfiles": {
      "type": "command",
      "title": "cd all panes: ~/.dotfiles",
      "subtitle": "Send `cd ~/.dotfiles` to every terminal in this workspace",
      "keywords": ["cd", "sync", "panes", "dotfiles"],
      "command": "~/.dotfiles/bin/cmux-cd-all ~/.dotfiles",
      "target": "currentTerminal"
    }
  },

  "commands": [
    {
      "name": "2 panes",
      "keywords": ["layout", "split", "panes"],
      "workspace": {
        "name": "2 panes",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            { "pane": { "surfaces": [{ "type": "terminal" }] } },
            { "pane": { "surfaces": [{ "type": "terminal" }] } }
          ]
        }
      }
    },
    {
      "name": "3 panes",
      "keywords": ["layout", "split", "panes"],
      "workspace": {
        "name": "3 panes",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "direction": "vertical",
              "split": 0.5,
              "children": [
                { "pane": { "surfaces": [{ "type": "terminal" }] } },
                { "pane": { "surfaces": [{ "type": "terminal" }] } }
              ]
            },
            { "pane": { "surfaces": [{ "type": "terminal" }] } }
          ]
        }
      }
    },
    {
      "name": "4 panes",
      "keywords": ["layout", "split", "panes"],
      "workspace": {
        "name": "4 panes",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "direction": "vertical",
              "split": 0.5,
              "children": [
                { "pane": { "surfaces": [{ "type": "terminal" }] } },
                { "pane": { "surfaces": [{ "type": "terminal" }] } }
              ]
            },
            {
              "direction": "vertical",
              "split": 0.5,
              "children": [
                { "pane": { "surfaces": [{ "type": "terminal" }] } },
                { "pane": { "surfaces": [{ "type": "terminal" }] } }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "5 panes",
      "keywords": ["layout", "split", "panes"],
      "workspace": {
        "name": "5 panes",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "split": 0.6,
          "children": [
            {
              "direction": "horizontal",
              "split": 0.5,
              "children": [
                {
                  "direction": "vertical",
                  "split": 0.5,
                  "children": [
                    { "pane": { "surfaces": [{ "type": "terminal" }] } },
                    { "pane": { "surfaces": [{ "type": "terminal" }] } }
                  ]
                },
                {
                  "direction": "vertical",
                  "split": 0.5,
                  "children": [
                    { "pane": { "surfaces": [{ "type": "terminal" }] } },
                    { "pane": { "surfaces": [{ "type": "terminal" }] } }
                  ]
                }
              ]
            },
            { "pane": { "surfaces": [{ "type": "terminal" }] } }
          ]
        }
      }
    },
    {
      "name": "6 panes",
      "keywords": ["layout", "split", "panes"],
      "workspace": {
        "name": "6 panes",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "direction": "vertical",
              "split": 0.3333,
              "children": [
                { "pane": { "surfaces": [{ "type": "terminal" }] } },
                {
                  "direction": "vertical",
                  "split": 0.5,
                  "children": [
                    { "pane": { "surfaces": [{ "type": "terminal" }] } },
                    { "pane": { "surfaces": [{ "type": "terminal" }] } }
                  ]
                }
              ]
            },
            {
              "direction": "vertical",
              "split": 0.3333,
              "children": [
                { "pane": { "surfaces": [{ "type": "terminal" }] } },
                {
                  "direction": "vertical",
                  "split": 0.5,
                  "children": [
                    { "pane": { "surfaces": [{ "type": "terminal" }] } },
                    { "pane": { "surfaces": [{ "type": "terminal" }] } }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "cd all panes: ~/.dotfiles",
      "keywords": ["cd", "sync", "panes", "dotfiles"],
      "run": "~/.dotfiles/bin/cmux-cd-all ~/.dotfiles"
    }
  ],

  "shortcuts": {
    "bindings": {
      // Free up cmd+shift+[ / cmd+shift+] from the surface (tab-in-pane)
      // shortcuts so they can be reused for pane focus below.
      "nextSurface": "unbound",
      "prevSurface": "unbound",

      // Directional pane focus on cmd+shift+arrows. Overrides the defaults
      // (cmd+opt+arrows) which conflict with Rectangle/macOS in this setup.
      "focusLeft":  "cmd+shift+←",
      "focusRight": "cmd+shift+→",
      "focusUp":    "cmd+shift+↑",
      "focusDown":  "cmd+shift+↓"
    }
  },


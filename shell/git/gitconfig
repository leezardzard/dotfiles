[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true

    # Pin the theme so delta does NOT auto-detect terminal colors. Auto-detection
    # emits OSC 10/11 queries; on short output the reply can arrive after delta
    # exits and get echoed as stray text (e.g. `10;rgb:ffff/ffff/ffff`). Our
    # terminals are dark (see ghostty config), so pin dark. Flip to light if needed.
    dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

# Machine-local identity (user.name/email) and git-lfs config live outside
# this tracked file so `bootstrap-zshrc.zsh` can redeploy it on every run
# without wiping per-machine settings. See ~/.gitconfig.local.
[include]
    path = ~/.gitconfig.local
.DS_Store

# Stray repo-root XDG dir: only ever appears as runtime cruft (e.g. a relative
# XDG_CONFIG_HOME while cwd is the repo). Linked config lives under home/, not here.
/.config/

# home/ mirrors $HOME and is tracked BY DEFAULT (convention over registry — a new
# dotfile under home/ is tracked and linked with no edits here). The only thing
# to exclude is runtime state that apps write THROUGH the symlinks back into the
# repo: logs, caches, and generated maps. Deny those explicitly; keep the rest.

# Known runtime state (the apps currently linked).
# NB: gitignore has no inline comments — keep each comment on its own line,
# or the trailing text becomes part of the pattern and the rule matches nothing.
# persisted repo->color map (cm color ...)
home/.config/cmux/colors.json
home/.config/fresh/logs/
# downloaded plugin packages
home/.config/fresh/plugins/
# session/usage stamps
home/.config/vercel-plugin/

# Defensive: runtime-output paths any future ~/.config app may create.
home/.config/**/logs/
home/.config/**/cache/
home/.config/**/*.log
